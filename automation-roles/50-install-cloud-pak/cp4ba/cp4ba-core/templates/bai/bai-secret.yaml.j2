apiVersion: v1
kind: Secret
metadata:
  name: custom-bpc-workforce-secret
  namespace: "{{ cp4ba_project_name }}"
type: Opaque
stringData:
  workforce-insights-configuration.yml: ""
---
apiVersion: v1
kind: Secret
metadata:
  name: custom-bai-secret
  namespace: "{{ cp4ba_project_name }}"
type: Opaque
stringData:
  management-username: "{{ lc_principal_admin_user }}"
  management-password: "{{ lc_principal_admin_password }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: custom-kafka-route-cert
  namespace: "{{ cp4ba_project_name }}"
type: kubernetes.io/tls
data:
  tls.key: "{{tls_key}}"
  tls.crt: "{{tls_crt}}"

---
apiVersion: v1
kind: Secret
metadata:
  name: {{instance_properties.name}}-dp-admin-credentials
  namespace: {{current_cp4i_cluster.project}}
data:
  password: ZHBhZG1pbjAxMTIzNTg=
type: Opaque
---
apiVersion: datapower.ibm.com/v1beta3
kind: DataPowerService
metadata:
  labels:
    backup.datapower.ibm.com/component: datapowerservice
  name: {{instance_properties.name}}
  namespace: {{current_cp4i_cluster.project}}
spec:
  license:
    accept: {{ _cpd_accept_licenses | default(False) }}
    use: nonproduction
    license: {{instance_properties.license}}
  replicas: 1
  resources:
    limits:
      memory: 4Gi
    requests:
      cpu: 1
      memory: 4Gi
  version: "{{instance_properties.version}}"
  users:
    - name: admin
      accessLevel: privileged
      passwordSecret: {{instance_properties.name}}-dp-admin-credentials
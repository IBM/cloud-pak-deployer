case-download \
    --release={{ _p_cp4d_version }} \
{% if _p_cp4d_version >= '5.4.0' and _p_cp4d_patch_id != '' -%}
    --patch_id={{ _p_cp4d_patch_id }} \
{% endif %}
{% if _from_oci | bool -%}
    --from_oci=true \
{% if _oci_location != '' %}
    --oci_location={{ _oci_location }} \
{% endif %}
{% endif -%}
{% if _p_cp4d_version >= '5.3.0' -%}
    --operator_ns={{ _p_current_cp4d_cluster.operators_project }} \
    --scheduler_ns={{ scheduling_service_project }} \
    --cluster_resources=true \
{% endif -%}   
{% if _p_preview | default(False) %}
    --preview=true \
{% endif %}
    --components=ibm-cert-manager,ibm-licensing,{{ _cartridges_to_install_list }}
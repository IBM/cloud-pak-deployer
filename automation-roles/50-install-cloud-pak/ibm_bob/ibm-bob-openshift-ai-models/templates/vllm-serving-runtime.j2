---
# vllm-serving-runtime.j2
# KServe ServingRuntime using vLLM for OpenShift AI (RawDeployment mode).
# Variables expected (set by caller):
#   _sr_name       — ServingRuntime name
#   _sr_namespace  — namespace
#   _sr_image      — vLLM container image
#   _sr_env        — list of {name, value} container environment variables ([] = none)
apiVersion: serving.kserve.io/v1alpha1
kind: ServingRuntime
metadata:
  name: "{{ _sr_name }}"
  namespace: "{{ _sr_namespace }}"
  labels:
    app.kubernetes.io/managed-by: cloud-pak-deployer
spec:
  multiModel: false
  supportedModelFormats:
    - name: vLLM
      version: "1"
      autoSelect: true
  containers:
    - name: kserve-container
      image: "{{ _sr_image }}"
      # The upstream vllm/vllm-openai image has `vllm serve` as entrypoint and
      # no `python` binary guaranteed, so the command is set explicitly.
      command:
        - vllm
        - serve
        - /mnt/models
      args:
        - "--port=8080"
        - "--served-model-name={{ _sr_name }}"
      ports:
        - containerPort: 8080
          protocol: TCP
      env: {{ ([{'name': 'HOME', 'value': '/tmp'}] + _sr_env) | to_json }}
      resources:
        requests:
          cpu: "4"
          memory: "16Gi"
        limits:
          cpu: "8"
          memory: "32Gi"
      volumeMounts:
        - name: shm
          mountPath: /dev/shm
  volumes:
    - name: shm
      emptyDir:
        medium: Memory
        sizeLimit: "2Gi"

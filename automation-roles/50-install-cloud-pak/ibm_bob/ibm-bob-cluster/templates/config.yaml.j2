# Configuration for IBM Bob {{ _ibm_bob_version }}
# Generated by Cloud Pak Deployer
global:
  operatorNamespace: {{ current_ibm_bob_cluster.operators_project | default('ibm-bob-operators') }}
  instanceNamespace: {{ current_ibm_bob_cluster.project }}
  fileStorageClass: {{ ocp_storage_class_file }}
  blockStorageClass: {{ ocp_storage_class_block }}
  imagePullPrefix: {{ _ibm_bob_image_pull_prefix }}
  imagePullSecretName: ibm-entitlement-key

bob:
  rag:
    enabled: {{ 'true' if (current_ibm_bob_cluster.premium_packages.rag | default(false)) else 'false' }}
  zProxy:
    enabled: {{ 'true' if (current_ibm_bob_cluster.premium_packages.z_proxy | default(false)) else 'false' }}
{% if current_ibm_bob_cluster.z_proxy_hash_api_secret_name | default('') != '' %}
    hashApiSecretName: "{{ current_ibm_bob_cluster.z_proxy_hash_api_secret_name }}"
{% endif %}
{% if current_ibm_bob_cluster.z_proxy_hash_api_secret_key_name | default('') != '' %}
    hashApiSecretKeyName: "{{ current_ibm_bob_cluster.z_proxy_hash_api_secret_key_name }}"
{% endif %}
  understand:
    enabled: {{ 'true' if (current_ibm_bob_cluster.premium_packages.understand | default(false)) else 'false' }}
{% if _ibm_bob_model_gateway_secrets | default({}) | length > 0 %}
  modelGateway:
    secrets:
{% for k, v in _ibm_bob_model_gateway_secrets.items() %}
      {{ k }}: {{ v | tojson }}
{% endfor %}
{% endif %}
